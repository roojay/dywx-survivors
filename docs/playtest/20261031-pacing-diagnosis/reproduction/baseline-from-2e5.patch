+ for(int tick=0;tick<1200*60;++tick){
+  if(s.GetSnapshot().phase==RunPhase::Dead||s.GetSnapshot().phase==RunPhase::Won)break;
+  auto oldChoices=choices.size();upgrades(s,policy==10?1:0,choices);
